def alphabeta(depth, node, alpha, beta, maximizing):
    if depth==3:
        return tree[node]
    
    if maximizing:
        best=-999
        
        for i in range(2):
            val=alphabeta(depth+1,node*2+i,alpha,beta,False)
            best=max(best,val)
            alpha=max(alpha,best)
            
            if beta <= alpha:
                break
            
        return best

    else:
        best=999
        
        for i in range(2):
            val=alphabeta(depth+1,node*2+i,alpha,beta,True)
            best=min(best,val)
            beta=min(beta,alpha)
            
            if beta <= alpha:
                break
            
        return best
    
tree=[3,5,6,9,1,2,0,-1]

print("Optimal value:",alphabeta(0,0,-999,999, True))
