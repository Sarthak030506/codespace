
visited = set()

def dfs(a, b, path):
    if (a, b) in visited:
        return False

    visited.add((a, b))
    path.append((a, b))

    if a == 2 or b == 2:
        print("Solution:", path)
        return True

    moves = [
        (4, b), (a, 3), (0, b), (a, 0),
        (a-min(a, 3-b), b+min(a, 3-b)),
        (a+min(b, 4-a), b-min(b, 4-a))
    ]

    for x, y in moves:
        if dfs(x, y, path):
            return True

    path.pop()
    return False

dfs(0, 0, [])
