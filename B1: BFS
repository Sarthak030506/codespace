
from collections import deque

grid = [
    [0, 0, 0, 0],
    [1, 1, 0, 1],
    [0, 0, 0, 0],
    [0, 1, 1, 0]
]

start = (0, 0)
goal = (3, 3)

q = deque([(start, [start])])
visited = {start}

while q:
    pos, path = q.popleft()

    if pos == goal:
        print("Path:", path)
        break

    r, c = pos

    for dr, dc in [(0,1), (1,0), (0,-1), (-1,0)]:
        nr, nc = r+dr, c+dc

        if 0 <= nr < 4 and 0 <= nc < 4:
            if grid[nr][nc] == 0 and (nr,nc) not in visited:
                visited.add((nr,nc))
                q.append(((nr,nc), path+[(nr,nc)]))
else:
    print("No path found")
